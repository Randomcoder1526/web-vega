# TMDB is used for metadata/artwork where enabled by the existing Vega UI.
TMDB_API_KEY=

# Optional existing metadata proxy used by this project.
PROXY_API_URL=

# Development only. Keep false in public deployments to prevent SSRF to LAN services.
ALLOW_PRIVATE_PROXY=false

# Optional provider/media response-header timeout (milliseconds).
UPSTREAM_HEADER_TIMEOUT_MS=20000
